# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Ei server er public URL (SSLCommerz callback er jonno). Local e ngrok URL dite hobe.
SERVER_URL=http://localhost:5000
# Web frontend er URL (payment er pore redirect hobe ekhane)
CLIENT_URL=http://localhost:3000
# CORS: comma diye multiple origin
CORS_ORIGINS=http://localhost:3000

# ---------- MongoDB (Next.js project er same DB) ----------
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
DB_NAME=beautyMart

# ---------- Firebase Admin (Firebase Console > Project settings > Service accounts > Generate new private key) ----------
FIREBASE_PROJECT_ID=beauty-mart-9043d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@beauty-mart-9043d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ---------- SSLCommerz ----------
STORE_ID=your_store_id
STORE_PASSWORD=your_store_password
SSL_IS_LIVE=false

# ---------- Resend (OTP email) ----------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=BeautyMart <onboarding@resend.dev>
